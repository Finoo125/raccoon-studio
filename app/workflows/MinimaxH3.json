{
  "1": {
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" }
  },
  "2": {
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Text Encoder" }
  },
  "3": {
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load Video VAE" }
  },
  "4": {
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load Audio VAE" }
  },
  "5": {
    "inputs": { "image": "example.png" },
    "class_type": "LoadImage",
    "_meta": { "title": "Source image (i2v only)" }
  },
  "6": {
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "",
      "width": 848,
      "height": 480,
      "length": 124,
      "first_frame": ["5", 0]
    },
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": { "title": "MiniMax H3 conditioning + latent" }
  },
  "7": {
    "inputs": { "sampler_name": "res_multistep" },
    "class_type": "KSamplerSelect",
    "_meta": { "title": "KSamplerSelect" }
  },
  "8": {
    "inputs": {
      "model": ["1", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": { "title": "BasicScheduler" }
  },
  "9": {
    "inputs": { "model": ["1", 0], "conditioning": ["6", 0] },
    "class_type": "BasicGuider",
    "_meta": { "title": "BasicGuider" }
  },
  "10": {
    "inputs": { "noise_seed": 0 },
    "class_type": "RandomNoise",
    "_meta": { "title": "RandomNoise" }
  },
  "11": {
    "inputs": {
      "noise": ["10", 0],
      "guider": ["9", 0],
      "sampler": ["7", 0],
      "sigmas": ["8", 0],
      "latent_image": ["6", 1]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": { "title": "SamplerCustomAdvanced" }
  },
  "12": {
    "inputs": { "samples": ["11", 0], "vae": ["3", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode video" }
  },
  "13": {
    "inputs": { "samples": ["11", 0], "vae": ["4", 0] },
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "Decode audio" }
  },
  "14": {
    "inputs": { "images": ["12", 0], "fps": 24, "audio": ["13", 0] },
    "class_type": "CreateVideo",
    "_meta": { "title": "CreateVideo" }
  },
  "15": {
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "video/MinimaxH3/%year%-%month%-%day%/%hour%%minute%%second%-MinimaxH3_",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Video" }
  }
}
