# Shell scripts must keep LF endings even when checked out on Windows.
# scripts/publish.ps1 copies the *working tree* into the public repo, so a CRLF
# checkout ships an install-linux.sh that Linux refuses to run ("bad interpreter:
# /usr/bin/env bash^M"). This shipped broken through v1.0.14.
*.sh text eol=lf

# The mirror image, and just as load-bearing: cmd.exe reads a batch file by byte
# offset, so an LF-only .bat drifts out of sync partway through and starts
# executing the wrong lines. "Upgrade Raccoon Studio.bat" carries a PowerShell
# payload after `exit /b`, and with LF endings cmd ran that payload as batch
# commands instead of stopping.
*.bat text eol=crlf

# install-linux.sh parses this manifest line by line, so it ships LF for the
# same reason. pinned_rev() strips a stray CR anyway — this keeps the file
# clean rather than relying on that.
installer/pinned-versions.txt text eol=lf

# Everything that ends up inside a Linux container, or is read by one, for the
# third time the same reason. A CRLF `run:` block in a workflow hands bash a
# literal ^M, and the RunPod pod runs proxy.mjs under node on Linux.
# runpod/boot.sh and entrypoint.sh are already covered by *.sh above — boot.sh
# especially, since the pod pipes it straight into `sh`.
.github/workflows/*.yml text eol=lf
runpod/*.mjs text eol=lf
